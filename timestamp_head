# ================= Helpers =================
def plot_confusion(y_true, y_pred, labels, path):
    cm = confusion_matrix(y_true, y_pred, labels=range(len(labels)))
    fig, ax = plt.subplots(figsize=(5,5))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=labels, yticklabels=labels, ax=ax)
    ax.set_xlabel('Predicted')
    ax.set_ylabel('True')
    plt.tight_layout()
    plt.savefig(path)
    plt.close(fig)

# ================= Dataset =================
class ClipAllDataset(Dataset):
    def __init__(self, meta_csv, videos_root, feature_extractor, resize=224, num_frames=4, clip_stride=1):
        self.df = pd.read_csv(meta_csv, sep=';')
        self.videos_root = videos_root
        self.fe = feature_extractor
        self.resize = resize
        self.num_frames = num_frames
        self.clip_stride = clip_stride
        self.samples = []
        self._build_index()

    def _safe_int(self, x, default=-1):
        return int(x) if (not pd.isna(x)) else default

    def _build_index(self):
        for _, row in self.df.iterrows():
            vid = row.get("video_id") if "video_id" in row.index else row.get("filename")
            path = os.path.join(self.videos_root, vid)
            if not os.path.exists(path):
                print(f"Warning: missing video {path}, skipping")
                continue
            cap = cv2.VideoCapture(path)
            fps = cap.get(cv2.CAP_PROP_FPS)
            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
            cap.release()
            if fps <= 0: fps = 25.0
            duration = total_frames / fps if total_frames > 0 else 0.0
            n_clips = int(math.ceil(duration))

            label_dump_video = self._safe_int(row.get("label_dump", 0))
            label_type_video = self._safe_int(row.get("label_type", -1))
            timestamp_video = self._safe_int(row.get("timestamp", -1))

            for sec in range(0, n_clips, self.clip_stride):
                label_dump = label_dump_video
                label_type = label_type_video if label_dump_video==1 else -1
                timestamp_label = 0
                if label_dump_video==1 and timestamp_video>=0:
                    if sec >= timestamp_video-3 and sec <= timestamp_video+10:
                        timestamp_label = 1
                self.samples.append({
                    "video_path": path,
                    "video_id": vid,
                    "start_sec": sec,
                    "label_dump": label_dump,
                    "label_type": label_type,
                    "timestamp_label": timestamp_label,
                    "duration": duration,
                    "timestamp": timestamp_video
                })

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        s = self.samples[idx]
        cap = cv2.VideoCapture(s["video_path"])
        fps = cap.get(cv2.CAP_PROP_FPS)
        if fps <= 0: fps = 25.0
        start_frame = int(s["start_sec"] * fps)
        frame_indices = [start_frame + int(i * (fps / self.num_frames)) for i in range(self.num_frames)]
        frames = []
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
        for fi in frame_indices:
            if fi >= total_frames: fi = max(0, total_frames - 1)
            cap.set(cv2.CAP_PROP_POS_FRAMES, fi)
            success, frame = cap.read()
            if not success or frame is None:
                frame = np.zeros((self.resize, self.resize, 3), dtype=np.uint8)
            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            frame = cv2.resize(frame, (self.resize, self.resize))
            frames.append(frame)
        cap.release()
        pixel_values = self.fe(frames, return_tensors="pt")["pixel_values"].squeeze(0)
        return {
            "video": pixel_values,
            "video_id": s["video_id"],
            "start_sec": s["start_sec"],
            "label_dump": int(s["label_dump"]),
            "label_type": int(s["label_type"]),
            "timestamp_label": int(s["timestamp_label"]),
            "timestamp": int(s["timestamp"])
        }

# ================= Model =================
class MultiHeadTimesformer(nn.Module):
    def __init__(self, pretrained_model_id):
        super().__init__()
        self.backbone = TimesformerForVideoClassification.from_pretrained(
            pretrained_model_id,
            ignore_mismatched_sizes=True,
            trust_remote_code=True,
            token=HF_TOKEN,
            use_safetensors=True
        )
        embed_dim = 768
        if hasattr(self.backbone, 'classifier') and hasattr(self.backbone.classifier, 'out_features'):
            embed_dim = self.backbone.classifier.out_features
        self.dump_head = nn.Linear(embed_dim, 2)
        self.type_head = nn.Linear(embed_dim, 2)
        self.timestamp_head = nn.Linear(embed_dim, 2)
        for p in self.backbone.parameters():
            p.requires_grad = False

    def _extract_feat(self, outputs):
        if hasattr(outputs, "pooler_output") and outputs.pooler_output is not None:
            return outputs.pooler_output
        if hasattr(outputs, "last_hidden_state") and outputs.last_hidden_state is not None:
            return outputs.last_hidden_state.mean(dim=1)
        return outputs.logits

    def forward(self, pixel_values):
        outputs = self.backbone(pixel_values, return_dict=True)
        feat = self._extract_feat(outputs)
        return self.dump_head(feat), self.type_head(feat), self.timestamp_head(feat)

# ================= Utility =================
def set_trainable(module, trainable=True):
    for p in module.parameters():
        p.requires_grad = trainable

def collate_batch(batch):
    videos = torch.stack([b['video'] for b in batch], dim=0)
    out = {"video": videos}
    out['label_dump'] = torch.tensor([b['label_dump'] for b in batch], dtype=torch.long)
    out['label_type'] = torch.tensor([b['label_type'] for b in batch], dtype=torch.long)
    out['timestamp_label'] = torch.tensor([b['timestamp_label'] for b in batch], dtype=torch.long)
    out['start_sec'] = torch.tensor([b['start_sec'] for b in batch], dtype=torch.long)
    out['video_id'] = [b['video_id'] for b in batch]
    out['timestamp'] = [b['timestamp'] for b in batch]
    return out

# ================= Evaluation =================
def evaluate_videos(model, clip_dataset, meta_csv, head="dump"):
    df = pd.read_csv(meta_csv, sep=';')
    model.eval()
    y_true, y_pred = [], []
    video_ids = df['video_id'].tolist()
    id2row = {r['video_id']: r for _, r in df.iterrows()}

    vid2indices = {}
    for i, s in enumerate(clip_dataset.samples):
        vid2indices.setdefault(s['video_id'], []).append(i)

    results_csv = []

    with torch.no_grad():
        for vid in tqdm(video_ids, desc=f'Eval {head} videos'):
            row = id2row.get(vid, None)
            if row is None: continue
            indices = sorted(vid2indices.get(vid, []), key=lambda i: clip_dataset.samples[i]['start_sec'])
            if len(indices) == 0:
                continue

            per_sec_pred = {}
            for idx in indices:
                sample = clip_dataset[idx]
                video_tensor = sample['video'].unsqueeze(0).to(device)
                dump_logits, type_logits, ts_logits = model(video_tensor)
                if head=="dump":
                    pred = int(torch.argmax(dump_logits, dim=1).cpu().numpy()[0])
                elif head=="type":
                    if sample['label_type']<0: continue
                    pred = int(torch.argmax(type_logits, dim=1).cpu().numpy()[0])
                elif head=="timestamp":
                    if sample['label_dump']!=1: continue
                    pred = int(torch.argmax(ts_logits, dim=1).cpu().numpy()[0])
                per_sec_pred[sample['start_sec']] = pred
                results_csv.append({
                    "video_id": vid,
                    "start_sec": sample['start_sec'],
                    "true_label": sample[f"label_{head}" if head!="timestamp" else "timestamp_label"],
                    "pred_label": pred
                })

            secs_sorted = sorted(per_sec_pred.keys())
            if head in ["dump","type"]:
                votes = [per_sec_pred[s] for s in secs_sorted]
                video_pred = 1 if sum(votes) >= len(votes)/2 else 0
                y_true.append(int(row['label_dump'] if head=="dump" else row['label_type']))
                y_pred.append(video_pred)
            elif head=="timestamp":
                pred_secs = sorted([s for s,v in per_sec_pred.items() if v==1])
                if len(pred_secs)==0:
                    predicted_ts = -1
                else:
                    first, last = pred_secs[0], pred_secs[-1]
                    predicted_ts = first + (4/14)*(last-first)
                y_true.append(int(row['timestamp']) if not pd.isna(row['timestamp']) else -1)
                y_pred.append(predicted_ts)

    pd.DataFrame(results_csv).to_csv(os.path.join(OUT_DIR, f"{head}_clip_predictions.csv"), index=False, sep=';')
    return y_true, y_pred

# ================= Main =================
if __name__ == '__main__':
    feature_extractor = AutoFeatureExtractor.from_pretrained(MODEL_ID, token=HF_TOKEN)

    # Conteggio video
    train_df = pd.read_csv(TRAIN_META, sep=';')
    test_df  = pd.read_csv(TEST_META, sep=';')
    print(f"Training videos total: {len(train_df)} (dump: {(train_df['label_dump']==1).sum()}, no-dump: {(train_df['label_dump']==0).sum()})")
    print(f"Test videos total:     {len(test_df)} (dump: {(test_df['label_dump']==1).sum()}, no-dump: {(test_df['label_dump']==0).sum()})")

    clip_train = ClipAllDataset(TRAIN_META, VIDEOS_ROOT, feature_extractor, resize=RESIZE, num_frames=NUM_FRAMES_CLIP, clip_stride=CLIP_STRIDE)
    clip_test  = ClipAllDataset(TEST_META,  VIDEOS_ROOT, feature_extractor, resize=RESIZE, num_frames=NUM_FRAMES_CLIP, clip_stride=CLIP_STRIDE)

    model = MultiHeadTimesformer(MODEL_ID).to(device)
    criterion_cls = nn.CrossEntropyLoss()

    # Dataloader filtrati
    loader_type = DataLoader(
        Subset(clip_train, [i for i,s in enumerate(clip_train.samples) if s['label_type']>=0 and s['label_dump']==1]),
        batch_size=BATCH_SIZE, shuffle=True, collate_fn=collate_batch
    )
    loader_timestamp = DataLoader(
        Subset(clip_train, [i for i,s in enumerate(clip_train.samples) if s['label_dump']==1]),
        batch_size=BATCH_SIZE, shuffle=True, collate_fn=collate_batch
    )

    optimizer_type = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=LR)
    optimizer_timestamp = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=LR)

    for epoch in range(1, NUM_EPOCHS+1):
        print(f"\n=== Epoch {epoch}/{NUM_EPOCHS} ===")

        # Congela backbone e dump_head
        set_trainable(model.backbone, False)
        set_trainable(model.dump_head, False)

        # Type head
        set_trainable(model.type_head, True)
        model.train()
        for batch in tqdm(loader_type, desc="Type train", leave=False):
            videos = batch['video'].to(device)
            labels = batch['label_type'].to(device)
            _, type_logits, _ = model(videos)
            loss = criterion_cls(type_logits, labels)
            optimizer_type.zero_grad()
            loss.backward()
            optimizer_type.step()

        # Timestamp head
        set_trainable(model.type_head, False)
        set_trainable(model.timestamp_head, True)
        model.train()
        for batch in tqdm(loader_timestamp, desc="Timestamp train", leave=False):
            videos = batch['video'].to(device)
            labels = batch['timestamp_label'].to(device)
            _, _, ts_logits = model(videos)
            loss = criterion_cls(ts_logits, labels)
            optimizer_timestamp.zero_grad()
            loss.backward()
            optimizer_timestamp.step()

        # ================= Evaluation =================
        print("\n--- Evaluation after epoch ---")
        for head in ["type","timestamp"]:
            y_true, y_pred = evaluate_videos(model, clip_test, TEST_META, head=head)
            if head=="type":
                # Voting majority video-level
                prec, rec, f1, _ = precision_recall_fscore_support(y_true, y_pred, average='macro', zero_division=0)
                acc = accuracy_score(y_true, y_pred)
                print(f"{head} head: Acc={acc:.3f}, P={prec:.3f}, R={rec:.3f}, F1={f1:.3f}")
                plot_confusion(y_true, y_pred, labels=[0,1], path=os.path.join(OUT_DIR, f'confusion_{head}_epoch{epoch}.png'))
            else:  # timestamp
                y_true_bin, y_pred_bin = [], []
                for true_ts, pred_ts in zip(y_true, y_pred):
                    if true_ts < 0: continue
                    y_true_bin.append(1)
                    if pred_ts >= true_ts-3 and pred_ts <= true_ts+10:
                        y_pred_bin.append(1)
                    else:
                        y_pred_bin.append(0)
                prec, rec, f1, _ = precision_recall_fscore_support(y_true_bin, y_pred_bin, average='macro', zero_division=0)
                acc = accuracy_score(y_true_bin, y_pred_bin)
                print(f"{head} head: Acc={acc:.3f}, P={prec:.3f}, R={rec:.3f}, F1={f1:.3f}")
                plot_confusion(y_true_bin, y_pred_bin, labels=[0,1], path=os.path.join(OUT_DIR, f'confusion_{head}_epoch{epoch}.png'))
