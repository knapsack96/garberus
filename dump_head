# ================= Helpers =================
def plot_confusion(y_true, y_pred, labels, path):
    cm = confusion_matrix(y_true, y_pred, labels=range(len(labels)))
    fig, ax = plt.subplots(figsize=(5,5))
    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', 
                xticklabels=labels, yticklabels=labels, ax=ax)
    ax.set_xlabel('Predicted')
    ax.set_ylabel('True')
    plt.tight_layout()
    plt.savefig(path)
    plt.close(fig)

# =============== Dataset EXTRA (nuovi video senza CSV) ===============
class ExtraVideoDataset(Dataset):
    """
    Carica video da due cartelle:
      - nuovi_dump       (label_dump = 1)
      - nuovi_no_dump    (label_dump = 0)
    """
    def __init__(self, root_dir, feature_extractor, resize=224, num_frames=4):
        self.root_dump = os.path.join(root_dir, "nuovi_dump")
        self.root_no  = os.path.join(root_dir, "nuovi_no_dump")

        self.resize = resize
        self.num_frames = num_frames
        self.fe = feature_extractor

        self.samples = []
        self._scan()

    def _scan(self):
        # dump clips → label 1
        if os.path.exists(self.root_dump):
            for f in os.listdir(self.root_dump):
                if f.lower().endswith((".mp4",".avi",".mov",".mkv")):
                    self.samples.append({
                        "path": os.path.join(self.root_dump, f),
                        "video_id": f,
                        "label_dump": 1
                    })

        # no_dump clips → label 0
        if os.path.exists(self.root_no):
            for f in os.listdir(self.root_no):
                if f.lower().endswith((".mp4",".avi",".mov",".mkv")):
                    self.samples.append({
                        "path": os.path.join(self.root_no, f),
                        "video_id": f,
                        "label_dump": 0
                    })

        print(f"Caricati {len(self.samples)} nuovi video extra (dump + no_dump).")

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        s = self.samples[idx]
        cap = cv2.VideoCapture(s["path"])
        fps = cap.get(cv2.CAP_PROP_FPS)
        if fps <= 0: fps = 25

        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))

        # Prendiamo NUM_FRAMES equamente distanziati
        frame_indices = np.linspace(0, max(0,total_frames-1), self.num_frames).astype(int)

        frames = []
        for fi in frame_indices:
            cap.set(cv2.CAP_PROP_POS_FRAMES, fi)
            ok, frame = cap.read()
            if not ok:
                frame = np.zeros((self.resize,self.resize,3), dtype=np.uint8)
            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            frame = cv2.resize(frame, (self.resize,self.resize))
            frames.append(frame)

        cap.release()

        pixel_values = self.fe(frames, return_tensors="pt")["pixel_values"].squeeze(0)

        return {
            "video": pixel_values,
            "video_id": s["video_id"],
            "label_dump": s["label_dump"]
        }


# ================= Dataset =================
class ClipAllDataset(Dataset):
    def __init__(self, meta_csv, videos_root, feature_extractor, resize=224, num_frames=4, clip_stride=1):
        self.df = pd.read_csv(meta_csv, sep=';')
        self.videos_root = videos_root
        self.fe = feature_extractor
        self.resize = resize
        self.num_frames = num_frames
        self.clip_stride = clip_stride
        self.samples = []
        self._build_index()

    def _safe_int(self, x, default=-1):
        return int(x) if (not pd.isna(x)) else default

    def _build_index(self):
        for _, row in self.df.iterrows():
            vid = row.get("video_id") if "video_id" in row.index else row.get("filename")
            path = os.path.join(self.videos_root, vid)

            if not os.path.exists(path):
                print(f"Warning: missing video {path}, skipping")
                continue

            cap = cv2.VideoCapture(path)
            fps = cap.get(cv2.CAP_PROP_FPS)
            total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))
            cap.release()

            if fps <= 0:
                fps = 25.0

            duration = total_frames / fps if total_frames > 0 else 0.0
            n_clips = int(math.ceil(duration))

            label_dump = self._safe_int(row.get("label_dump", 0))

            for sec in range(0, n_clips, self.clip_stride):
                self.samples.append({
                    "video_path": path,
                    "video_id": vid,
                    "start_sec": sec,
                    "label_dump": label_dump,
                    "duration": duration,
                })

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        s = self.samples[idx]
        cap = cv2.VideoCapture(s["video_path"])
        fps = cap.get(cv2.CAP_PROP_FPS)

        if fps <= 0:
            fps = 25.0

        start_frame = int(s["start_sec"] * fps)
        frame_indices = [start_frame + int(i * (fps / self.num_frames)) 
                         for i in range(self.num_frames)]

        frames = []
        total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))

        for fi in frame_indices:
            if fi >= total_frames:
                fi = max(0, total_frames - 1)
            cap.set(cv2.CAP_PROP_POS_FRAMES, fi)
            success, frame = cap.read()
            if not success or frame is None:
                frame = np.zeros((self.resize, self.resize, 3), dtype=np.uint8)

            frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            frame = cv2.resize(frame, (self.resize, self.resize))
            frames.append(frame)

        cap.release()

        pixel_values = self.fe(frames, return_tensors="pt")["pixel_values"].squeeze(0)
        return {
            "video": pixel_values,
            "video_id": s["video_id"],
            "start_sec": s["start_sec"],
            "label_dump": int(s["label_dump"]),
        }

# ================= Model =================
class MultiHeadTimesformer(nn.Module):
    def __init__(self, pretrained_model_id):
        super().__init__()
        self.backbone = TimesformerForVideoClassification.from_pretrained(
            pretrained_model_id,
            ignore_mismatched_sizes=True,
            trust_remote_code=True,
            token=HF_TOKEN,
            use_safetensors=True
        )

        embed_dim = 768
        if hasattr(self.backbone, "classifier") and hasattr(self.backbone.classifier, "out_features"):
            embed_dim = self.backbone.classifier.out_features

        self.dump_head = nn.Linear(embed_dim, 2)

        for p in self.backbone.parameters():
            p.requires_grad = False

    def _extract_feat(self, outputs):
        if hasattr(outputs, "pooler_output") and outputs.pooler_output is not None:
            return outputs.pooler_output

        if hasattr(outputs, "last_hidden_state") and outputs.last_hidden_state is not None:
            return outputs.last_hidden_state.mean(dim=1)

        return outputs.logits

    def forward(self, pixel_values):
        outputs = self.backbone(pixel_values, return_dict=True)
        feat = self._extract_feat(outputs)
        dump_logits = self.dump_head(feat)
        return dump_logits

# ================= Utility =================
def set_trainable(module, trainable=True):
    for p in module.parameters():
        p.requires_grad = trainable

def collate_batch(batch):
    videos = torch.stack([b['video'] for b in batch], dim=0)
    return {
        "video": videos,
        "label_dump": torch.tensor([b['label_dump'] for b in batch], dtype=torch.long),
        "video_id": [b['video_id'] for b in batch],
        "start_sec": torch.tensor([b['start_sec'] for b in batch], dtype=torch.long)
    }

# ================= Evaluation =================
def evaluate_videos(model, clip_dataset, meta_csv, head="dump"):
    df = pd.read_csv(meta_csv, sep=';')
    model.eval()
    y_true, y_pred = [], []

    video_ids = df['video_id'].tolist()
    id2row = {r['video_id']: r for _, r in df.iterrows()}

    vid2indices = {}
    for i, s in enumerate(clip_dataset.samples):
        vid2indices.setdefault(s['video_id'], []).append(i)

    results_csv = []

    with torch.no_grad():
        for vid in tqdm(video_ids, desc="Eval dump videos"):
            row = id2row[vid]
            indices = sorted(vid2indices.get(vid, []), 
                             key=lambda i: clip_dataset.samples[i]['start_sec'])

            if len(indices) == 0:
                continue

            per_sec_pred = {}

            for idx in indices:
                sample = clip_dataset[idx]
                vid_tensor = sample['video'].unsqueeze(0).to(device)
                dump_logits = model(vid_tensor)

                pred = int(torch.argmax(dump_logits, dim=1).cpu().item())
                per_sec_pred[sample['start_sec']] = pred

                results_csv.append({
                    "video_id": vid,
                    "start_sec": sample['start_sec'],
                    "true_label": sample["label_dump"],
                    "pred_label": pred
                })

            secs_sorted = sorted(per_sec_pred.keys())
            votes = [per_sec_pred[s] for s in secs_sorted]
            video_pred = 1 if sum(votes) >= len(votes)/2 else 0

            y_true.append(int(row['label_dump']))
            y_pred.append(video_pred)

    pd.DataFrame(results_csv).to_csv(
        os.path.join(OUT_DIR, f"dump_clip_predictions.csv"), 
        index=False, sep=';'
    )

    return y_true, y_pred

# ================= Main =================
if __name__ == '__main__':
    feature_extractor = AutoFeatureExtractor.from_pretrained(MODEL_ID, token=HF_TOKEN)

    clip_train = ClipAllDataset(TRAIN_META, VIDEOS_ROOT, feature_extractor,
                                resize=RESIZE, num_frames=NUM_FRAMES_CLIP, clip_stride=CLIP_STRIDE)

    extra_dataset = ExtraVideoDataset(
    root_dir=BASE_DIR,
    feature_extractor=feature_extractor,
    resize=RESIZE,
    num_frames=NUM_FRAMES_CLIP
    )

    # Merge dataset originale + dataset extra
    from torch.utils.data import ConcatDataset

    full_train_dataset = ConcatDataset([clip_train, extra_dataset])

    loader_dump = DataLoader(
    full_train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True,
    collate_fn=collate_batch
    )


    clip_test  = ClipAllDataset(TEST_META, VIDEOS_ROOT, feature_extractor,
                                resize=RESIZE, num_frames=NUM_FRAMES_CLIP, clip_stride=CLIP_STRIDE)

    model = MultiHeadTimesformer(MODEL_ID).to(device)
    criterion = nn.CrossEntropyLoss()

    subset_dump = Subset(clip_train, list(range(len(clip_train))))
    loader_dump = DataLoader(subset_dump, batch_size=BATCH_SIZE, shuffle=True, collate_fn=collate_batch)

    optimizer_dump = optim.Adam(filter(lambda p: p.requires_grad, model.parameters()), lr=LR)

    ckpts = [f for f in os.listdir(OUT_DIR) if f.startswith("checkpoint_solo_dump") and f.endswith(".pth")]
    if len(ckpts) > 0:
        ckpts_sorted = sorted(ckpts, key=lambda x: int(x.replace("checkpoint_solo_dump", "").replace(".pth", "")))
        last_ckpt = ckpts_sorted[-1]
        ckpt_path = os.path.join(OUT_DIR, last_ckpt)
        print(f"Loading checkpoint: {last_ckpt}")
        model.load_state_dict(torch.load(ckpt_path, map_location=device))
        start_epoch = int(last_ckpt.replace("checkpoint_solo_dump", "").replace(".pth", "")) + 1
    else:
        print("No checkpoint found, starting from scratch.")
        start_epoch = 1

    for epoch in range(start_epoch, NUM_EPOCHS+1):
        print(f"\n=== Epoch {epoch}/{NUM_EPOCHS} ===")

        set_trainable(model.backbone, False)
        set_trainable(model.dump_head, True)

        model.train()
        for batch in tqdm(loader_dump, desc="Dump train", leave=False):
            videos = batch['video'].to(device)
            labels = batch['label_dump'].to(device)

            dump_logits = model(videos)
            loss = criterion(dump_logits, labels)

            optimizer_dump.zero_grad()
            loss.backward()
            optimizer_dump.step()

        ckpt_path = os.path.join(OUT_DIR, f"checkpoint_extradati_solo_dump{epoch}.pth")
        torch.save(model.state_dict(), ckpt_path)
        print(f"Checkpoint saved at {ckpt_path}")

        print("\n--- Evaluation ---")

        y_true, y_pred = evaluate_videos(model, clip_test, TEST_META, head="dump")

        if len(y_true) > 0:
            prec, rec, f1, _ = precision_recall_fscore_support(
                y_true, y_pred, average='macro', zero_division=0
            )
            acc = accuracy_score(y_true, y_pred)
            print(f"Dump head: Acc={acc:.3f}, P={prec:.3f}, R={rec:.3f}, F1={f1:.3f}")
            plot_confusion(y_true, y_pred, labels=[0,1],
                           path=os.path.join(OUT_DIR, f'confusion_extradati_dump_epoch{epoch}.png'))
